# Copy to .env and fill in. Never commit .env.
# Values marked REQUIRED make the API/worker refuse to start (or fail at import) when missing.

# --- LLM ---------------------------------------------------------------------
# REQUIRED. Groq Cloud (https://console.groq.com). Used for extraction, the
# Researcher/Analyst, and the Auditor.
GROQ_API_KEY=

# --- Data sources ------------------------------------------------------------
# Needed for POST /api/ingest (topic ingestion). https://newsapi.org/register
NEWSAPI_KEY=

# SEC EDGAR asks for an identifying contact email in the User-Agent. No signup.
# Falls back to a placeholder address if unset.
SEC_CONTACT_EMAIL=

# Needed only for Reddit lookups (Ask agent tool, /api/social/*).
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Neo4j -------------------------------------------------------------------
# NEO4J_URI and NEO4J_USER are read without defaults by the retrieval and graph
# modules, so set all three. For Neo4j Aura use neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# REQUIRED. docker-compose.yml also uses this as the local Neo4j password.
# Note: Neo4j only applies it when its data volume is first created.
NEO4J_PASSWORD=

# --- Qdrant ------------------------------------------------------------------
# Leave blank to use a local Qdrant at http://localhost:6333.
QDRANT_URL=
QDRANT_API_KEY=

# --- Redis / Celery ----------------------------------------------------------
# Leave blank for redis://localhost:6379. docker-compose.prod.yml overrides this.
REDIS_URL=

# --- Behaviour ---------------------------------------------------------------
# Contradiction detection strategy: keyword | embedding | llm (default: keyword)
CONFLICT_STRATEGY=keyword

# Python log level for the API and workers (default: INFO)
LOG_LEVEL=INFO

# Reference prices (USD per 1M tokens) used only to *estimate* run cost on the
# Impact page. Defaults are in agents/graph.py; override if you want different numbers.
# COST_PER_M_INPUT_TOKENS_USD=
# COST_PER_M_OUTPUT_TOKENS_USD=

# Slack incoming webhook for the daily watchlist digest. If unset, the digest is
# logged instead of sent.
SLACK_WEBHOOK_URL=

# --- API access --------------------------------------------------------------
# Shared-secret header (X-API-Key) required on every /api/* route except /health.
# Blank disables auth (local development only). The dashboard's server-side proxy
# sends this same value (docker-compose.prod.yml passes it through; for `npm run dev`
# set API_KEY in dashboard/.env.local).
API_KEY=

# Extra browser origins allowed to call the API directly, comma-separated, e.g.
# https://dashboard.example.com. Blank allows http://localhost:<any port> only.
# The bundled dashboard does not need this because it calls the API through its own proxy.
CORS_ORIGINS=
