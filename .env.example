# Groq Cloud (https://console.groq.com) — fast/free Llama-3 inference
GROQ_API_KEY=

# NewsAPI.org (https://newsapi.org/register) — free tier, powers topic search ingestion
NEWSAPI_KEY=

# SEC EDGAR requires an identifying contact email per its fair-access policy — no signup needed
SEC_CONTACT_EMAIL=

# Reddit (https://www.reddit.com/prefs/apps) — create a "script" app, free
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Neo4j — local Docker default shown; for Neo4j Aura use neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant — omit both to use local Docker Qdrant at http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# Redis — omit to use localhost (bare-metal dev); docker-compose.prod.yml overrides this to redis://redis:6379
REDIS_URL=

# Contradiction-detection strategy: keyword | embedding | llm
CONFLICT_STRATEGY=keyword

# Slack incoming webhook (https://api.slack.com/messaging/webhooks) — powers the daily
# digest for watchlist entities. Omit to have digests logged instead of sent.
SLACK_WEBHOOK_URL=

# Shared-secret API key required on every /api/* route (X-API-Key header) except
# /health. Leave blank to disable auth entirely — fine for local dev, but set
# this before deploying anywhere reachable from the public internet.
API_KEY=

# Only needed when building the dashboard image (docker-compose.prod.yml) —
# set to your EC2 public IP/domain, e.g. http://1.2.3.4:8000
NEXT_PUBLIC_API_URL=

# Must match API_KEY above — the dashboard sends this as X-API-Key on every
# request. Leave both blank together, or set both together.
NEXT_PUBLIC_API_KEY=
